{
  "$schema": "https://raw.githubusercontent.com/JanDeDobbeleer/oh-my-posh/main/themes/schema.json",
  "version": 2,
  "final_space": true,
  "blocks": [
    {
      "type": "prompt",
      "alignment": "left",
      "segments": [
        {
          "type": "text",
          "style": "powerline",
          "powerline_symbol": "\uE0B0",
          "foreground": "p:base",
          "background": "p:accent",
          "template": " FOXTERM "
        },
        {
          "type": "text",
          "style": "powerline",
          "powerline_symbol": "\uE0B0",
          "foreground": "p:base",
          "background": "p:accent2",
          "template": " {{ if .Env.FOXTERM_USER }}{{ .Env.FOXTERM_USER }}{{ else }}{{ .UserName }}{{ end }} "
        },
        {
          "type": "time",
          "style": "powerline",
          "powerline_symbol": "\uE0B0",
          "foreground": "p:base",
          "background": "p:accent4",
          "properties": { "time_format": "15:04" },
          "template": " {{ .CurrentDate | date .Format }} "
        }
      ]
    },
    {
      "type": "prompt",
      "alignment": "left",
      "newline": true,
      "segments": [
        {
          "type": "text",
          "style": "plain",
          "foreground": "p:accent",
          "template": "\u276F "
        }
      ]
    }
  ],
  "palette": {
    "base": "#0B0F1A",
    "text": "#E6E6E6",
    "accent": "#7D93B0",
    "accent2": "#90A9CA",
    "accent3": "#6A7D96",
    "accent4": "#A2BFE5"
  }
}
