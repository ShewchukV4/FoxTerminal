<Window x:Class="RemoteFlow.Agent.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="RemoteFlow Agent"
        Height="720" Width="1100"
        MinHeight="600" MinWidth="900"
        Background="{StaticResource BgBrush}"
        WindowStartupLocation="CenterScreen">
  <Grid>
    <Grid.ColumnDefinitions>
      <ColumnDefinition Width="220"/>
      <ColumnDefinition Width="*"/>
    </Grid.ColumnDefinitions>

    <!-- Sidebar -->
    <Border Grid.Column="0" Background="#0E1626" Padding="16">
      <DockPanel>
        <StackPanel DockPanel.Dock="Top" Margin="0,8,0,24">
          <TextBlock Text="RemoteFlow" FontSize="22" FontWeight="Bold" Foreground="{StaticResource TextBrush}"/>
          <TextBlock Text="Windows Agent" Foreground="{StaticResource MutedBrush}" Margin="0,4,0,0"/>
        </StackPanel>
        <StackPanel DockPanel.Dock="Bottom" Margin="0,16,0,0">
          <Button x:Name="BtnStartStop" Content="Start Server" Style="{StaticResource PrimaryButton}" Click="BtnStartStop_OnClick"/>
        </StackPanel>
        <StackPanel>
          <Button Content="Dashboard" Style="{StaticResource NavButton}" Tag="dash" Click="Nav_OnClick"/>
          <Button Content="Devices" Style="{StaticResource NavButton}" Tag="devices" Click="Nav_OnClick"/>
          <Button Content="Actions" Style="{StaticResource NavButton}" Tag="actions" Click="Nav_OnClick"/>
          <Button Content="Settings" Style="{StaticResource NavButton}" Tag="settings" Click="Nav_OnClick"/>
          <Button Content="Logs" Style="{StaticResource NavButton}" Tag="logs" Click="Nav_OnClick"/>
        </StackPanel>
      </DockPanel>
    </Border>

    <!-- Content -->
    <Grid Grid.Column="1" Margin="24">
      <!-- Dashboard -->
      <ScrollViewer x:Name="PageDash" VerticalScrollBarVisibility="Auto">
        <StackPanel>
          <TextBlock Text="Dashboard" FontSize="28" FontWeight="SemiBold" Foreground="{StaticResource TextBrush}"/>
          <UniformGrid Columns="3" Margin="0,20,0,0">
            <Border Background="{StaticResource CardBrush}" CornerRadius="16" Padding="18" Margin="0,0,12,12">
              <StackPanel>
                <TextBlock Text="Server" Foreground="{StaticResource MutedBrush}"/>
                <TextBlock x:Name="TxtServerState" Text="Stopped" FontSize="22" FontWeight="Bold" Foreground="{StaticResource DangerBrush}" Margin="0,8,0,0"/>
              </StackPanel>
            </Border>
            <Border Background="{StaticResource CardBrush}" CornerRadius="16" Padding="18" Margin="0,0,12,12">
              <StackPanel>
                <TextBlock Text="Address" Foreground="{StaticResource MutedBrush}"/>
                <TextBlock x:Name="TxtAddress" Text="—" FontSize="16" FontWeight="SemiBold" Foreground="{StaticResource TextBrush}" Margin="0,8,0,0" TextWrapping="Wrap"/>
              </StackPanel>
            </Border>
            <Border Background="{StaticResource CardBrush}" CornerRadius="16" Padding="18" Margin="0,0,0,12">
              <StackPanel>
                <TextBlock Text="Devices" Foreground="{StaticResource MutedBrush}"/>
                <TextBlock x:Name="TxtDeviceCount" Text="0" FontSize="22" FontWeight="Bold" Foreground="{StaticResource TextBrush}" Margin="0,8,0,0"/>
              </StackPanel>
            </Border>
            <Border Background="{StaticResource CardBrush}" CornerRadius="16" Padding="18" Margin="0,0,12,12">
              <StackPanel>
                <TextBlock Text="Remote control" Foreground="{StaticResource MutedBrush}"/>
                <TextBlock x:Name="TxtRemote" Text="On" FontSize="18" FontWeight="SemiBold" Foreground="{StaticResource OkBrush}" Margin="0,8,0,0"/>
              </StackPanel>
            </Border>
            <Border Background="{StaticResource CardBrush}" CornerRadius="16" Padding="18" Margin="0,0,12,12">
              <StackPanel>
                <TextBlock Text="Screen share" Foreground="{StaticResource MutedBrush}"/>
                <TextBlock x:Name="TxtScreen" Text="Off" FontSize="18" FontWeight="SemiBold" Foreground="{StaticResource MutedBrush}" Margin="0,8,0,0"/>
              </StackPanel>
            </Border>
            <Border Background="{StaticResource CardBrush}" CornerRadius="16" Padding="18" Margin="0,0,0,12">
              <StackPanel>
                <TextBlock Text="Streaming" Foreground="{StaticResource MutedBrush}"/>
                <TextBlock x:Name="TxtStreaming" Text="Idle" FontSize="18" FontWeight="SemiBold" Foreground="{StaticResource MutedBrush}" Margin="0,8,0,0"/>
              </StackPanel>
            </Border>
          </UniformGrid>

          <Border Background="{StaticResource CardBrush}" CornerRadius="16" Padding="20" Margin="0,8,0,0">
            <Grid>
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
              </Grid.ColumnDefinitions>
              <StackPanel>
                <TextBlock Text="Connect iPhone" FontSize="18" FontWeight="SemiBold" Foreground="{StaticResource TextBrush}"/>
                <TextBlock Text="Scan the QR code in Safari (same Wi‑Fi). You will confirm pairing here." Foreground="{StaticResource MutedBrush}" Margin="0,6,0,12" TextWrapping="Wrap"/>
                <TextBlock x:Name="TxtQrUrl" Foreground="{StaticResource Accent2Brush}" TextWrapping="Wrap"/>
              </StackPanel>
              <Image x:Name="ImgQr" Grid.Column="1" Width="180" Height="180" Margin="16,0,0,0"/>
            </Grid>
          </Border>

          <Border x:Name="PairBanner" Visibility="Collapsed" Background="#2A1F4D" CornerRadius="16" Padding="18" Margin="0,16,0,0">
            <DockPanel>
              <StackPanel>
                <TextBlock Text="Pairing request" FontWeight="SemiBold" Foreground="{StaticResource TextBrush}"/>
                <TextBlock x:Name="TxtPairInfo" Foreground="{StaticResource MutedBrush}" Margin="0,6,0,0"/>
              </StackPanel>
              <StackPanel Orientation="Horizontal" DockPanel.Dock="Right" HorizontalAlignment="Right">
                <Button Content="Reject" Style="{StaticResource GhostButton}" Margin="0,0,8,0" Click="BtnRejectPair_OnClick"/>
                <Button Content="Approve" Style="{StaticResource PrimaryButton}" Click="BtnApprovePair_OnClick"/>
              </StackPanel>
            </DockPanel>
          </Border>
        </StackPanel>
      </ScrollViewer>

      <!-- Devices -->
      <DockPanel x:Name="PageDevices" Visibility="Collapsed">
        <TextBlock DockPanel.Dock="Top" Text="Devices" FontSize="28" FontWeight="SemiBold" Foreground="{StaticResource TextBrush}" Margin="0,0,0,16"/>
        <ListBox x:Name="ListDevices" Background="Transparent" BorderThickness="0" Foreground="{StaticResource TextBrush}">
          <ListBox.ItemTemplate>
            <DataTemplate>
              <Border Background="{StaticResource CardBrush}" CornerRadius="12" Padding="14" Margin="0,0,0,10">
                <DockPanel>
                  <StackPanel>
                    <TextBlock Text="{Binding Name}" FontWeight="SemiBold" Foreground="#E8EEF9"/>
                    <TextBlock Text="{Binding StatusText}" Foreground="#8B9BB8" Margin="0,4,0,0"/>
                  </StackPanel>
                  <StackPanel Orientation="Horizontal" DockPanel.Dock="Right" HorizontalAlignment="Right">
                    <Button Content="Disconnect" Tag="{Binding DeviceId}" Style="{StaticResource GhostButton}" Margin="0,0,8,0" Click="BtnDisconnect_OnClick"/>
                    <Button Content="Remove" Tag="{Binding DeviceId}" Style="{StaticResource GhostButton}" Click="BtnRemoveDevice_OnClick"/>
                  </StackPanel>
                </DockPanel>
              </Border>
            </DataTemplate>
          </ListBox.ItemTemplate>
        </ListBox>
      </DockPanel>

      <!-- Actions -->
      <ScrollViewer x:Name="PageActions" Visibility="Collapsed" VerticalScrollBarVisibility="Auto">
        <StackPanel>
          <TextBlock Text="Actions" FontSize="28" FontWeight="SemiBold" Foreground="{StaticResource TextBrush}"/>
          <TextBlock Text="Allowlisted apps, URLs and folders. Mobile clients cannot run arbitrary commands." Foreground="{StaticResource MutedBrush}" Margin="0,6,0,16" TextWrapping="Wrap"/>
          <TextBlock Text="Apps" FontWeight="SemiBold" Foreground="{StaticResource TextBrush}"/>
          <ListBox x:Name="ListApps" Height="140" Margin="0,8,0,16" Background="{StaticResource CardBrush}" BorderThickness="0" Foreground="{StaticResource TextBrush}"/>
          <TextBlock Text="URLs" FontWeight="SemiBold" Foreground="{StaticResource TextBrush}"/>
          <ListBox x:Name="ListUrls" Height="120" Margin="0,8,0,16" Background="{StaticResource CardBrush}" BorderThickness="0" Foreground="{StaticResource TextBrush}"/>
          <TextBlock Text="Folders" FontWeight="SemiBold" Foreground="{StaticResource TextBrush}"/>
          <ListBox x:Name="ListFolders" Height="120" Margin="0,8,0,16" Background="{StaticResource CardBrush}" BorderThickness="0" Foreground="{StaticResource TextBrush}"/>

          <Border Background="{StaticResource CardBrush}" CornerRadius="12" Padding="14">
            <StackPanel>
              <TextBlock Text="Add allowlisted URL" FontWeight="SemiBold" Foreground="{StaticResource TextBrush}"/>
              <Grid Margin="0,10,0,0">
                <Grid.ColumnDefinitions>
                  <ColumnDefinition Width="160"/>
                  <ColumnDefinition Width="*"/>
                  <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <TextBox x:Name="TxtNewUrlName" Margin="0,0,8,0" Padding="8"/>
                <TextBox x:Name="TxtNewUrl" Grid.Column="1" Margin="0,0,8,0" Padding="8"/>
                <Button Grid.Column="2" Content="Add" Style="{StaticResource PrimaryButton}" Click="BtnAddUrl_OnClick"/>
              </Grid>
              <TextBlock Text="Add allowlisted app path (.exe)" FontWeight="SemiBold" Foreground="{StaticResource TextBrush}" Margin="0,16,0,0"/>
              <Grid Margin="0,10,0,0">
                <Grid.ColumnDefinitions>
                  <ColumnDefinition Width="160"/>
                  <ColumnDefinition Width="*"/>
                  <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <TextBox x:Name="TxtNewAppName" Margin="0,0,8,0" Padding="8"/>
                <TextBox x:Name="TxtNewAppPath" Grid.Column="1" Margin="0,0,8,0" Padding="8"/>
                <Button Grid.Column="2" Content="Add" Style="{StaticResource PrimaryButton}" Click="BtnAddApp_OnClick"/>
              </Grid>
            </StackPanel>
          </Border>
        </StackPanel>
      </ScrollViewer>

      <!-- Settings -->
      <ScrollViewer x:Name="PageSettings" Visibility="Collapsed" VerticalScrollBarVisibility="Auto">
        <StackPanel>
          <TextBlock Text="Settings" FontSize="28" FontWeight="SemiBold" Foreground="{StaticResource TextBrush}" Margin="0,0,0,16"/>
          <Border Background="{StaticResource CardBrush}" CornerRadius="16" Padding="18">
            <StackPanel>
              <CheckBox x:Name="ChkRemote" Content="Allow remote control" Foreground="{StaticResource TextBrush}" Margin="0,0,0,10" Checked="SettingChanged" Unchecked="SettingChanged"/>
              <CheckBox x:Name="ChkScreen" Content="Allow screen sharing" Foreground="{StaticResource TextBrush}" Margin="0,0,0,10" Checked="SettingChanged" Unchecked="SettingChanged"/>
              <CheckBox x:Name="ChkLanOnly" Content="Local network only (recommended)" Foreground="{StaticResource TextBrush}" Margin="0,0,0,10" Checked="SettingChanged" Unchecked="SettingChanged"/>
              <CheckBox x:Name="ChkAutostart" Content="Start server when Agent opens" Foreground="{StaticResource TextBrush}" Margin="0,0,0,16" Checked="SettingChanged" Unchecked="SettingChanged"/>
              <TextBlock Text="Port" Foreground="{StaticResource MutedBrush}"/>
              <TextBox x:Name="TxtPort" Width="120" HorizontalAlignment="Left" Margin="0,6,0,12" Padding="8"/>
              <TextBlock Text="Stream target FPS" Foreground="{StaticResource MutedBrush}"/>
              <TextBox x:Name="TxtFps" Width="120" HorizontalAlignment="Left" Margin="0,6,0,12" Padding="8"/>
              <Button Content="Save settings" Style="{StaticResource PrimaryButton}" HorizontalAlignment="Left" Click="BtnSaveSettings_OnClick"/>
            </StackPanel>
          </Border>
        </StackPanel>
      </ScrollViewer>

      <!-- Logs -->
      <DockPanel x:Name="PageLogs" Visibility="Collapsed">
        <TextBlock DockPanel.Dock="Top" Text="Logs" FontSize="28" FontWeight="SemiBold" Foreground="{StaticResource TextBrush}" Margin="0,0,0,16"/>
        <TextBox x:Name="TxtLogs" IsReadOnly="True" TextWrapping="Wrap" AcceptsReturn="True"
                 VerticalScrollBarVisibility="Auto" Background="{StaticResource CardBrush}"
                 Foreground="{StaticResource TextBrush}" BorderThickness="0" Padding="12"
                 FontFamily="Consolas"/>
      </DockPanel>
    </Grid>
  </Grid>
</Window>
